@@ -0,0 +1,33 @@
+// Counts registry requests per timed install: packuments vs tarballs.
+// usage: node count-requests.mjs <run log> <pnpr.log>
+import fs from 'fs'
+
+const [runLog, pnprLog] = process.argv.slice(2)
+
+const windows = []
+let section = ''
+let cmd = ''
+let start = null
+for (const line of fs.readFileSync(runLog, 'utf8').split('\n')) {
+  if (line.startsWith('# t-start ')) start = Date.parse(line.slice(10))
+  else if (line.startsWith('# t-end ')) {
+    windows.push({ section, cmd, start, end: Date.parse(line.slice(8, 32)) })
+  } else if (line.startsWith('# ')) section = line.slice(2)
+  else if (line.startsWith('> ') && / install/.test(line)) cmd = line.slice(2, 60)
+}
+
+const reqs = []
+const re = /^(\S+Z)\s.*latency_ms=(\d+) method=(\w+) uri=(\S+)/
+for (const line of fs.readFileSync(pnprLog, 'utf8').split('\n')) {
+  const m = re.exec(line)
+  if (m) reqs.push({ t: Date.parse(m[1]), latency: Number(m[2]), method: m[3], uri: m[4] })
+}
+
+for (const w of windows) {
+  const inWin = reqs.filter((r) => r.t >= w.start && r.t <= w.end + 50)
+  const tgz = inWin.filter((r) => r.uri.includes('/-/') && r.uri.endsWith('.tgz'))
+  const meta = inWin.filter((r) => r.method === 'GET' && !r.uri.includes('/-/'))
+  const other = inWin.length - tgz.length - meta.length
+  const secs = ((w.end - w.start) / 1000).toFixed(2)
+  console.log(`${w.section.padEnd(48)} ${secs.padStart(6)}s  packuments=${String(meta.length).padStart(5)}  tarballs=${String(tgz.length).padStart(5)}  other=${other}`)
+}
