# Lock files - fyn-lock.yaml is committed for every package, but not for
# nested demos and test fixtures. Other managers' locks are named explicitly
# rather than via `*-lock*`, which once swallowed tracked source files.
packages/*/*/**/fyn-lock.yaml
package-lock.json
yarn.lock
pnpm-lock.yaml
