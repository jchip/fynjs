{
  "packages": ["packages/*", "_w/*"],
  "fyn": {
    "options": {
      "allowScripts": {
        "@npmcli/template-oss": {
          "semver": "^5.0.0",
          "scripts": ["postinstall"]
        },
        "esbuild": {
          "semver": "^0.25.12 || ^0.28.2",
          "scripts": ["postinstall"]
        }
      }
    }
  },
  "command": {
    "publish": {
      "tags": {
        "v3": {
          "enabled": true,
          "packages": {
            "fynpo": true,
            "fyn": true
          }
        }
      }
    }
  },
  "ignore": [
    "packages/pacote-jchip"
  ],
  "caching": {
    "enable": false,
    "server": "http://localhost:8080/upload",
    "pruning": {
      "highCount": 12,
      "keepCount": 6
    },
    "alwaysUploadToRemote": true
  },
  "packageCache": {
    "default": {
      "input": {
        "npmScripts": [
          "prepare",
          "prepublish",
          "build:release",
          "build"
        ],
        "include": [
          "**/*"
        ],
        "exclude": [
          "**/?(node_modules|.vscode|.DS_Store|coverage|.nyc_output|.fynpo|.git|.github|.gitignore|docs|docusaurus|packages|tmp|.etmp|samples|dist|dist-*|build)",
          "**/*.?(log|md)"
        ],
        "includeEnv": [
          "NODE_ENV"
        ],
        "includeVersions": [
          "node"
        ]
      },
      "output": {
        "include": "",
        "filesFromNpmPack": true,
        "exclude": [
          "**/?(node_modules|.vscode|.DS_Store|coverage|.nyc_output|.fynpo|src|docusaurus)",
          "**/*.log"
        ]
      }
    }
  },
  "lifecycleCache": {
    "default": {
      "input": {
        "npmScripts": [
          "test",
          "coverage",
          "ci:check"
        ],
        "include": [
          "**/*"
        ],
        "exclude": [
          "**/?(node_modules|.vscode|.DS_Store|coverage|.nyc_output|.fynpo|.git|.github|.gitignore|docs|docusaurus|packages|tmp|.etmp|samples|dist|dist-*|build)",
          "**/*.?(log|md)",
          "**/.fynpo-data.json"
        ],
        "includeEnv": [
          "NODE_ENV"
        ],
        "includeVersions": [
          "node"
        ]
      },
      "output": {
        "include": [
          "coverage"
        ],
        "exclude": []
      }
    }
  },
  "versionLocks": [
    [
      "fynpo",
      "fyn",
      "fynpo-cli"
    ]
  ]
}
