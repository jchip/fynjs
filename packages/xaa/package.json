{
  "name": "xaa",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "async/await/Promise helpers - delay, defer, timeout, each, map, filter",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run vitest && npm run demo:cjs && npm run demo:esm",
    "ci:check": "tsc --noEmit -p tsconfig.json && npm test",
    "vitest": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write src test demo vitest.config.ts",
    "demo:cjs": "cd demo/sample-1-cjs && fyn install && node demo.cjs",
    "demo:esm": "cd demo/sample-1-esm && fyn install && node demo.js",
    "prepublishOnly": "npm run coverage && npm run build && npm run docs",
    "docs": "typedoc --gitRevision $(git rev-list -1 HEAD src) --out docs src",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "homepage": "https://jchip.github.io/xaa/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/xaa"
  },
  "keywords": [
    "async",
    "await",
    "Promise",
    "helpers",
    "async/await",
    "delay",
    "defer",
    "timeout",
    "each",
    "map",
    "filter"
  ],
  "files": [
    "dist"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.5.3",
    "publish-util": "^2.1.0",
    "source-map-support": "^0.5.21",
    "tsx": "^4.19.4",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "prettier": {
    "printWidth": 100,
    "trailingComma": "none",
    "arrowParens": "avoid"
  },
  "dependencies": {}
}
