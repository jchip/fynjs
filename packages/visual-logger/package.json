{
  "name": "visual-logger",
  "version": "1.1.3",
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/visual-logger",
  "description": "Visual logger for CLI in NodeJS",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/visual-logger"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "visual",
    "cli",
    "logger",
    "log",
    "logging",
    "console",
    "terminal",
    "term",
    "update",
    "progress",
    "bar",
    "stdout",
    "tty",
    "spinner",
    "animation",
    "refresh"
  ],
  "files": [
    "dist"
  ],
  "author": "Joel Chen <joel123@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "^6.0.0",
    "log-update": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.2",
    "prettier": "^3.5.3",
    "publish-util": "^2.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  },
  "prettier": {
    "printWidth": 100
  },
  "sideEffects": false
}
