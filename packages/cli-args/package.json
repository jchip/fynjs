{
  "name": "@fynjs/cli-args",
  "version": "1.0.0",
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/cli-args",
  "description": "Simple, lightweight, flexible, and comprehensive Command Line Argument Parsing for node.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && npm test",
    "test-debug": "vitest run --inspect-brk --no-file-parallelism",
    "coveralls": "vitest run --coverage && cat coverage/lcov.info | coveralls",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun --serial [[build, docs], coverage]",
    "docs": "typedoc --gitRevision $(git rev-list -1 HEAD src | cut -c1-8) --out docs src",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "publishUtil": {
    "remove": [
      "/scripts.*/"
    ],
    "keep": [
      "exports"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/cli-args"
  },
  "files": [
    "dist",
    "examples"
  ],
  "keywords": [
    "unix",
    "un*x",
    "clap",
    "lightweight",
    "command",
    "line",
    "argument",
    "arguments",
    "parsing",
    "cli",
    "yargs",
    "argparse",
    "commander",
    "optimist"
  ],
  "author": "Joel Chen <joel123@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {},
  "devDependencies": {
    "@fynjs/run": "^0.0.1",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.5.3",
    "publish-util": "^2.1.0",
    "source-map-support": "^0.5.21",
    "tsx": "^4.19.4",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "avoid",
    "trailingComma": "none"
  },
  "sideEffects": false
}
