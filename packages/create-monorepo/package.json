{
  "name": "@fynjs/create-monorepo",
  "version": "1.0.6",
  "description": "Create a new fynpo monorepo",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "homepage": "https://github.com/jchip/fynjs",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && vitest run",
    "docs": "typedoc --gitRevision $(git rev-list -1 HEAD src | cut -c1-8) --out docs src",
    "prepublishOnly": "xrun --serial build docs && publish-util-prepublishonly",
    "postpack": "publish-util-postpack",
    "prepack": "publish-util-prepack"
  },
  "bin": {
    "create-monorepo": "bin/create-monorepo.js",
    "create-fynpo": "bin/create-monorepo.js"
  },
  "keywords": [],
  "author": "Walmart GTP.js Team and Contributors",
  "contributors": [
    "Divya Vannilaparambath"
  ],
