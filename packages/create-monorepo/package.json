  "repository": {
    "type": "git",
    "url": "https://github.com/jchip/fynjs.git"
  },
  "devDependencies": {
    "@fynjs/run": "^1.1.0",
    "@types/node": "^22.15.30",
    "@types/shelljs": "^0.8.17",
    "publish-util": "^3.1.0",
    "typedoc": "^0.28.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "chalker": "^2.1.0",
    "lodash": "^4.17.21",
    "@fynjs/cli-args": "^1.1.0",
    "prompts": "^2.4.1",
