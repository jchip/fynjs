{
  "name": "fyn",
  "version": "3.0.0",
  "description": "fyn is the NPM for fynpo -- a zero setup monorepo tool",
  "main": "./bin/fyn.js",
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/fyn",
  "license": "Apache-2.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "debug-test": "node --inspect-brk node_modules/.bin/vitest --extension ts,js,tsx,jsx,cjs,mjs test/spec",
    "compile-yarn": "babel yarn/src --out-dir yarn/lib",
    "build": "node build.mjs",
    "analyze": "ANALYZE_BUNDLE=1 xrun compile-yarn bundle",
    "coverage": "vitest run --coverage",
    "ci:check": "vitest run --coverage",
    "coveralls": "cat coverage/lcov.info | coveralls",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack",
    "blah": "exit 5",
    "test-npm-a": "npm run test-npm-b",
    "test-npm-b": "env",
    "hello1": "npm run hello -- from npm",
    "hello": "echo hello"
  },
  "bin": {
    "0-npx-please-run-this-for-fyn": "./bin/fyn.js",
    "fyn": "./bin/fyn.js",
    "fun": "./bin/fun.js"
  },
  "author": "Walmart GTP.js Team and Contributors",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com/",
    "tag": "v3"
  },
  "files": [
    "bin",
    "dist"
  ],
  "keywords": [
    "node",
    "node_modules",
    "module",
    "modules",
    "fast",
    "package",
    "manager",
    "enhanced",
    "local",
    "better",
    "improve",
    "npm",
    "link",
    "development",
    "workflow",
    "productivity",
    "efficient",
    "disk",
    "space",
    "usage",
    "monorepo",
    "mono-repo",
    "workspaces"
  ],
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jchip/fynjs.git",
    "directory": "packages/fyn"
  },
  "publishUtil": {
    "remove": [
      "dependencies"
    ]
  },
  "contributors": [
    "Joel Chen",
    "Dat Vong",
    "Divya Karippath"
  ],
  "dependencies": {
    "@fynpo/base": "^2.0.0",
    "@jchip/error": "^2.0.0",
    "@npmcli/arborist": "^10.0.2",
    "@npmcli/run-script": "^11.0.0",
    "aveazul": "^2.0.0",
    "cacache": "^21.0.1",
    "chalk": "^6.0.0",
    "chalker": "^2.0.0",
    "check-pkg-new-version-engine": "^2.0.0",
    "ci-info": "^4.0.0",
    "filter-scan-dir": "^2.0.0",
    "ini": "^7.0.0",
    "init-package": "^1.0.0",
    "invariant": "^2.2.4",
    "item-queue": "^2.0.0",
    "lockfile": "^1.0.4",
    "lodash": "^4.17.21",
    "minimatch": "^10.2.6",
    "@fynjs/cli-args": "^1.0.0",
    "npm-packlist": "^11.3.0",
    "npm-registry-fetch": "^20.0.1",
    "optional-require": "^2.1.1",
    "pacote": "^22.0.0",
    "pkg-preper": "^0.2.0",
    "publish-util": "^3.0.0",
    "semver": "^7.3.5",
    "source-map": "^0.8.0",
    "ssri": "^14.0.0",
    "strip-bom": "^5.0.0",
    "tar": "^7.5.22",
    "visual-exec": "^1.0.0",
    "visual-logger": "^2.0.0",
    "xaa": "^3.0.0",
    "xenv-config": "^2.0.0",
    "xsh": "^1.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.16.0",
    "@babel/core": "^7.16.0",
    "@babel/preset-env": "^7.2.0",
    "@babel/preset-flow": "^7.16.0",
    "@fynjs/run": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "agentkeepalive": "^3.5.3",
    "electrode-server": "^3.0.3",
    "node-fetch-npm": "^2.0.4",
    "patch-package": "^8.0.0",
    "prettier": "^3.5.3",
    "rolldown": "^1.2.6",
    "tsx": "^4.21.0",
    "v8-compile-cache": "^2.3.0",
    "vite": "^7.3.1",
    "vite-node": "^5.2.0",
    "vitest": "^4.1.11",
    "which": "^2.0.2",
    "xstdout": "^0.1.1"
  },
  "nyc": {
    "all": true,
    "reporter": [
      "lcov",
      "text",
      "text-summary"
    ],
    "exclude": [
      "*/pkg-bin-linker-win32.js",
      "*clap.js",
      "*clap.ts",
      "bin",
      "cli/config",
      "cli/fun.js",
      "cli/fun.ts",
      "lib/util/file-ops-win32.js",
      "coverage",
      "dist",
      "docs",
      "gulpfile.js",
      "stubs",
      "test",
      "testing",
      "tmp",
      "webpack.config.js",
      "xout",
      "xrun*.js",
      "xrun*.ts",
      "yarn"
    ],
    "extends": [],
    "check-coverage": true,
    "statements": 75,
    "branches": 64,
    "functions": 80,
    "lines": 75,
    "cache": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "prettier": {
    "printWidth": 100
  },
  "fyn": {
    "dependencies": {}
  }
}
