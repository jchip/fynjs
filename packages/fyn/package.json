{
  "name": "fyn",
  "type": "module",
  "version": "3.1.2",
  "description": "fyn is the NPM for fynpo -- a zero setup monorepo tool",
  "main": "./bin/index.mjs",
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/fyn",
  "license": "Apache-2.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:gate": "node typecheck-gate.mjs",
    "typecheck:baseline": "node typecheck-gate.mjs --update",
    "debug-test": "node --inspect-brk node_modules/.bin/vitest --extension ts,js,tsx,jsx,cjs,mjs test/spec",
    "build": "node build.mjs",
    "analyze": "ANALYZE_BUNDLE=1 xrun bundle",
    "coverage": "vitest run --coverage",
    "ci:check": "node typecheck-gate.mjs && vitest run --coverage",
    "coveralls": "cat coverage/lcov.info | coveralls",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack",
    "blah": "exit 5",
    "test-npm-a": "npm run test-npm-b",
    "test-npm-b": "env",
    "hello1": "npm run hello -- from npm",
    "hello": "echo hello"
  },
  "bin": {
    "0-npx-please-run-this-for-fyn": "./bin/fyn.mjs",
    "fyn": "./bin/fyn.mjs",
    "fun": "./bin/fun.mjs"
  },
  "author": "Walmart GTP.js Team and Contributors",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com/",
    "tag": "v3"
  },
  "files": [
    "bin",
    "dist"
  ],
  "keywords": [
    "node",
    "node_modules",
    "module",
    "modules",
    "fast",
    "package",
    "manager",
    "enhanced",
    "local",
    "better",
    "improve",
    "npm",
    "link",
    "development",
    "workflow",
    "productivity",
    "efficient",
    "disk",
    "space",
    "usage",
    "monorepo",
    "mono-repo",
    "workspaces"
  ],
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jchip/fynjs.git",
    "directory": "packages/fyn"
  },
  "publishUtil": {
    "remove": [
      "dependencies"
    ]
  },
  "contributors": [
    "Joel Chen",
    "Dat Vong",
    "Divya Karippath"
  ],
  "dependencies": {
    "@fynpo/base": "^2.1.1",
    "@jchip/error": "^2.1.1",
    "@npmcli/arborist": "^10.0.2",
    "@npmcli/run-script": "^11.0.0",
    "aveazul": "^2.1.1",
    "cacache": "^21.0.1",
    "chalk": "^6.0.0",
    "chalker": "^2.1.1",
    "check-pkg-new-version-engine": "^2.1.1",
    "ci-info": "^4.0.0",
    "filter-scan-dir": "^2.1.1",
    "ini": "^7.0.0",
    "init-package": "^1.0.0",
    "invariant": "^2.2.4",
    "item-queue": "^2.1.2",
    "lockfile": "^1.0.4",
    "lodash-es": "^4.18.1",
    "minimatch": "^10.2.6",
    "@fynjs/cli-args": "^1.1.1",
    "@fynjs/fetch": "^1.0.0",
    "npm-packlist": "^11.3.0",
    "npm-registry-fetch": "^20.0.1",
    "optional-require": "^2.1.1",
    "pacote": "^22.0.0",
    "pkg-preper": "^0.3.1",
    "publish-util": "^3.1.1",
    "semver": "^7.3.5",
    "source-map": "^0.8.0",
    "ssri": "^14.0.0",
    "strip-bom": "^5.0.0",
    "tar": "^7.5.22",
    "visual-exec": "^1.1.2",
    "visual-logger": "^2.1.2",
    "xaa": "^3.1.1",
    "xenv-config": "^2.1.1",
    "xsh": "^1.1.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@fynjs/run": "^1.1.1",
    "@fynjs/ts-resolve": "^1.0.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "agentkeepalive": "^4.6.0",
    "js-yaml": "^5.4.1",
    "patch-package": "^8.0.0",
    "prettier": "^3.5.3",
    "rolldown": "^1.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "which": "^6.0.1",
    "xstdout": "^1.0.0"
  },
  "nyc": {
    "all": true,
    "reporter": [
      "lcov",
      "text",
      "text-summary"
    ],
    "exclude": [
      "*/pkg-bin-linker-win32.js",
      "*clap.js",
      "*clap.ts",
      "bin",
      "cli/config",
      "cli/fun.js",
      "cli/fun.ts",
      "lib/util/file-ops-win32.js",
      "coverage",
      "dist",
      "docs",
      "gulpfile.js",
      "stubs",
      "test",
      "testing",
      "tmp",
      "webpack.config.js",
      "xout",
      "xrun*.js",
      "xrun*.ts",
      "yarn"
    ],
    "extends": [],
    "check-coverage": true,
    "statements": 75,
    "branches": 64,
    "functions": 80,
    "lines": 75,
    "cache": true
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "prettier": {
    "printWidth": 100
  },
  "fyn": {
    "dependencies": {}
  }
}
