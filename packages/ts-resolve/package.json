{
  "name": "@fynjs/ts-resolve",
  "version": "1.0.0",
  "description": "Resolve TypeScript sources for node's built-in type stripping - no transpiler",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/register.js"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "typescript",
    "node",
    "loader",
    "resolve",
    "type-stripping"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/ts-resolve"
  }
}
