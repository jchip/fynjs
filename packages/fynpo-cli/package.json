{
  "name": "fynpo-cli",
  "version": "3.0.2",
  "description": "npm install globally to provide the fynpo command",
  "type": "module",
  "preferGlobal": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/fynpo-cli",
  "bin": {
    "fynpo": "dist/fynpo.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "xrun build",
    "docs": "typedoc --gitRevision $(git rev-list -1 HEAD src | cut -c1-8) --out docs src",
    "ci:check": "tsc --noEmit && vitest run",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "fyn",
    "lerna",
    "repo",
    "mono",
    "monorepo"
  ],
  "author": "Walmart GTP.js Team and Contributors",
  "contributors": [
    "Joel Chen",
    "Divya Vannilaparambath"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jchip/fynjs.git",
    "directory": "packages/fynpo-cli"
  },
  "dependencies": {},
  "devDependencies": {
    "@fynjs/run": "^1.0.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.1",
    "@types/node": "^22.15.30",
    "prettier": "^3.5.3",
    "publish-util": "^3.0.0",
    "source-map-support": "^0.5.19",
    "typedoc": "^0.28.14",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "prettier": {
    "printWidth": 100
  }
}
