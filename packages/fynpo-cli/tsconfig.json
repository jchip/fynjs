{
  "compilerOptions": {
    // TypeScript 7 turns `strict` on by default; this package has always been checked
    // without it. Pinned off so the upgrade preserves the existing bar rather than
    // silently raising it. Turning it on is worthwhile, but is its own piece of work.
    "strict": false,
    "skipLibCheck": true,
    "outDir": "dist",
    // TS7 (TS5011) requires this to be explicit; "./bin" is the same common source
    // directory TS inferred before, so the emitted layout is unchanged.
    "rootDir": "./bin",
    "lib": [
      "es2022"
    ],
    "module": "NodeNext",
    "esModuleInterop": true,
    "importHelpers": false,
    "target": "ES2022",
    "preserveConstEnums": true,
    "sourceMap": true,
    "declaration": true,
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "strictFunctionTypes": true,
    "moduleResolution": "NodeNext"
  },
  "include": [
    "bin"
  ]
}
