{
  "name": "@fynpo/base",
  "version": "2.1.2",
  "description": "zero setup monorepo manager for node.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/fynpo-base",
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/fynpo-base"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && npm test",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "keywords": [
    "fynpo",
    "monorepo",
    "dep graph",
    "topo",
    "workspace"
  ],
  "author": "Joel Chen",
  "contributors": [
    "Divya Vannilaparambath",
    "Joel Chen",
    "Walmart GTP.js Team and Contributors"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com/"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "npm-packlist": "^11.3.0",
    "prettier": "^3.5.3",
    "publish-util": "^3.1.1",
    "run-verify": "^2.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "filter-scan-dir": "^2.1.2",
    "ignore": "^7.0.6",
    "lodash-es": "^4.18.1",
    "minimatch": "^10.0.3",
    "optional-import": "^1.1.1",
    "semver": "^7.7.2"
  },
  "files": [
    "dist"
  ],
  "prettier": {
    "printWidth": 100
  },
  "fyn": {
    "dependencies": {}
  },
  "sideEffects": false
}
