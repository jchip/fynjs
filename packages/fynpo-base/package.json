{
  "name": "@fynpo/base",
  "version": "1.1.23",
  "description": "zero setup monorepo manager for node.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/fynpo-base",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/fynpo-base"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && npm test",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "keywords": [],
  "author": "Walmart GTP.js Team and Contributors",
  "contributors": [
    "Divya Vannilaparambath",
    "Joel Chen"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com/"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^4.1.11",
    "npm-packlist": "^11.3.0",
    "prettier": "^3.5.3",
    "publish-util": "^2.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "filter-scan-dir": "^1.6.0",
    "ignore": "^7.0.6",
    "lodash": "^4.17.21",
    "minimatch": "^10.0.3",
    "optional-import": "^1.0.0",
    "semver": "^7.7.2"
  },
  "files": [
    "dist"
  ],
  "prettier": {
    "printWidth": 100
  },
  "fyn": {
    "dependencies": {}
  },
  "sideEffects": false
}
