{
  "name": "init-package",
  "version": "1.0.0",
  "description": "initialize package.json for npm package",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/init-package",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && vitest run",
    "coverage": "vitest run --coverage"
  },
  "private": true,
  "author": "",
  "files": [
    "dist"
  ],
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/init-package"
  },
  "dependencies": {
    "enquirer": "^2.3.6",
    "lodash": "^4.17.21",
    "semver": "^7.3.5"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.15.30",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "prettier": {
    "printWidth": 100
  },
  "sideEffects": false
}
