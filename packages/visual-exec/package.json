{
  "name": "visual-exec",
  "version": "0.2.0",
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/visual-exec",
  "description": "Visual shell exec with spinners and progress display",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "xrun --serial build test",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/visual-exec"
  },
  "keywords": [
    "visual",
    "shell",
    "exec",
    "spinner",
    "progress"
  ],
  "files": [
    "dist"
  ],
  "author": "Joel Chen <joel123@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "^6.0.0",
    "ci-info": "^3.2.0",
    "has-ansi": "^4.0.1",
    "strip-ansi": "^6.0.0",
    "visual-logger": "^1.1.3",
    "xsh": "^0.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.2.2",
    "publish-util": "^2.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  },
  "prettier": {
    "printWidth": 100,
    "trailingComma": "none",
    "arrowParens": "avoid"
  },
  "sideEffects": false
}
