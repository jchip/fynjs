{
  "name": "item-queue",
  "version": "2.1.3",
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/item-queue",
  "description": "An item processing queue with Promise",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && npm test",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/item-queue"
  },
  "keywords": [
    "concurrent",
    "item",
    "process",
    "processing",
    "pause",
    "resume",
    "watch",
    "timer",
    "queue",
    "promise"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "dependencies": {
    "xflight": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "aveazul": "^2.1.2",
    "chalk": "^6.0.0",
    "prettier": "^3.5.3",
    "publish-util": "^3.1.1",
    "run-verify": "^2.1.2",
    "typescript": "^7.0.2",
    "visual-logger": "^2.1.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "prettier": {
    "printWidth": 100
  },
  "sideEffects": false
}
