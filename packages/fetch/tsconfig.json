{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "outDir": "dist",
    "rootDir": "./src",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "target": "ES2022",
    "declaration": true,
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src"
  ]
}
