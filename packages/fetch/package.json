{
  "name": "@fynjs/fetch",
  "version": "1.0.0",
  "description": "Hardened, zero-dependency HTTP client based on Node core fetch",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/fetch",
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/fetch"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "fyn build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "fetch",
    "http",
    "https",
    "client",
    "retry"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.5.3",
    "run-verify": "^2.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
