{
  "name": "munchy",
  "version": "2.0.0",
  "description": "A producer Node stream for draining different data, including Readable streams",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/munchy",
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/munchy"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ci:check": "tsc --noEmit -p tsconfig.json && vitest run --coverage",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "keywords": [
    "node",
    "stream",
    "producer",
    "drain",
    "draining",
    "multiple",
    "different",
    "data",
    "buffer",
    "string"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com/"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "publish-util": "^3.1.1",
    "run-verify": "^2.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "prettier": {
    "printWidth": 100,
    "trailingComma": "none"
  }
}
