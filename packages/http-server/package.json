{
  "name": "@fynjs/http-server",
  "version": "1.0.0",
  "private": true,
  "description": "A configurable Fastify web server, mirroring electrode-server's surface",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && npm test",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "fastify",
    "server",
    "electrode-server"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "dependencies": {
    "@fynjs/confippet": "^1.0.0",
    "chalk": "^6.0.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "xaa": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.5.3",
    "run-verify": "^2.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/http-server"
  }
}
