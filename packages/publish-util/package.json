{
  "name": "publish-util",
  "version": "3.1.0",
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/publish-util",
  "description": "Some util to clean up package.json for npm publish",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && npm test",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "node check.js && xrun build",
    "prepack": "node bin/publish-util-prepack.js",
    "postpack": "node bin/publish-util-postpack.js",
    "postinstall": "node dist/postinstall.js || true"
  },
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/publish-util"
  },
  "bin": {
    "publish-util-prepublishonly": "bin/publish-util-prepublishonly.js",
    "publish-util-prepack": "bin/publish-util-prepack.js",
    "publish-util-postpack": "bin/publish-util-postpack.js",
    "do-publish": "bin/do-publish.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.com/",
    "access": "public"
  },
  "files": [
    "bin",
    "dist"
  ],
  "keywords": [
    "npm",
    "publish",
    "cleanup",
    "clean",
    "package.json",
    "util"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "dependencies": {
    "find-up": "^8.0.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "prettier": {
    "printWidth": 100
  },
  "sideEffects": false
}
