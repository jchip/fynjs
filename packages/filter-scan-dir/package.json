{
  "name": "filter-scan-dir",
  "version": "1.6.0",
  "description": "Recursively scan and filter directory for a flat array of files",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "_clean": "rm -rf dist-*",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "ci": "xrun --serial build test coverage",
    "clean": "rm -rf dist-* coverage",
    "prepack": "publish-util-prepack",
    "prepublishOnly": "xrun ci",
    "docs": "typedoc src/index.ts --out docs && touch docs/.nojekyll",
    "postpack": "publish-util-postpack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/filter-scan-dir"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.com/"
  },
  "files": [
    "index.cjs",
    "dist"
  ],
  "keywords": [
    "util",
    "recursive",
    "filter",
    "scan",
    "walk",
    "dir",
    "directory",
    "readdir",
    "fs",
    "fast",
    "glob"
  ],
  "author": "Joel Chen <joel123@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jchip/filter-scan-dir/issues"
  },
  "homepage": "https://github.com/jchip/filter-scan-dir",
  "dependencies": {},
  "devDependencies": {
    "@fynjs/run": "^0.0.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.13",
    "@vitest/ui": "^4.0.13",
    "prettier": "^3.6.2",
    "publish-util": "^2.1.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "prettier": {
    "printWidth": 100
  },
  "sideEffects": false
}
