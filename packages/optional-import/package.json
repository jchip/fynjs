{
  "name": "optional-import",
  "version": "1.1.2",
  "description": "ESM import that lets you handle module not found without try/catch, and tells 'not installed' apart from 'installed but broken'",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && npm test",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/optional-import",
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/optional-import"
  },
  "keywords": [
    "optional",
    "import",
    "esm",
    "optional dependency",
    "optional dependencies",
    "dynamic import",
    "import.meta.resolve",
    "module not found"
  ],
  "files": [
    "dist"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.5.3",
    "publish-util": "^3.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "prettier": {
    "printWidth": 100
  },
  "sideEffects": false
}
