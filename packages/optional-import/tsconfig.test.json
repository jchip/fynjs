{
  // Type-check gate that covers tests as well as src. It cannot live in
  // tsconfig.json because that one drives the `tsc` build and pins
  // `rootDir: "./src"` to keep the emitted layout; test files sit outside it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Only for test/fixtures/app/probe.ts, which is spawned as a real `node probe.ts`
    // child process by test/spec/integration.spec.ts. Node's type-stripping does not
    // map a `.js` specifier back to a `.ts` file, so that one import must stay `.ts`.
    // Every other test here imports src as `.js`, matching the rest of the repo.
    // Only legal alongside `noEmit`, hence only here; it relaxes no type checking.
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test"
  ]
}
