{
  "name": "pkg-preper",
  "version": "0.1.8",
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/pkg-preper",
  "description": "Package Preparer",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && npm test",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "author": "Joel Chen <joel123@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/pkg-preper"
  },
  "license": "Artistic-2.0",
  "dependencies": {
    "cacache": "^21.0.0",
    "npm-packlist": "^11.3.0",
    "opfs": "^1.1.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/cacache": "^20.0.1",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.5.3",
    "publish-util": "^2.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "prettier": {
    "printWidth": 100
  },
  "sideEffects": false
}
