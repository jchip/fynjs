{
  "name": "xflight",
  "version": "2.0.2",
  "description": "Handle inflight promise to avoid async duplication",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jchip/fynjs.git",
    "directory": "packages/xflight"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "inflight",
    "promise"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@vitest/coverage-v8": "^3.2.0",
    "@xarc/run": "^1.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "sideEffects": false
}
