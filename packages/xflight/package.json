{
  "name": "xflight",
  "version": "3.1.0",
  "description": "Handle inflight promise to avoid async duplication",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && npm test",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/xflight",
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jchip/fynjs.git",
    "directory": "packages/xflight"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "inflight",
    "promise"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "devDependencies": {
    "@fynjs/run": "^1.1.0",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^4.1.11",
    "publish-util": "^3.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "sideEffects": false
}
