{
  "name": "unwrap-npm-cmd",
  "version": "1.1.2",
  "description": "Unwrap npm's node.js bin CMD batch for js files on Windows",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.cjs",
    "dist"
  ],
  "keywords": [
    "unwrap-npm-cmd",
    "unwrap",
    "npm",
    "cmd",
    "batch",
    "windows"
  ],
  "author": "Joel Chen <joel123@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/unwrap-npm-cmd"
  },
  "dependencies": {
    "tslib": "^2.6.2",
    "which": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^3.2.2",
    "prettier": "^3.5.3",
    "publish-util": "^2.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  },
  "prettier": {
    "printWidth": 100
  },
  "sideEffects": false
}
