{
  "name": "unwrap-npm-cmd",
  "version": "2.1.1",
  "description": "Unwrap npm's node.js bin CMD batch for js files on Windows",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && npm test",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.cjs",
    "dist"
  ],
  "keywords": [
    "unwrap-npm-cmd",
    "unwrap",
    "npm",
    "cmd",
    "batch",
    "windows"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/unwrap-npm-cmd",
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/unwrap-npm-cmd"
  },
  "dependencies": {
    "which": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.5.3",
    "publish-util": "^3.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "prettier": {
    "printWidth": 100
  },
  "sideEffects": false
}
