{
  "name": "fynpo",
  "version": "3.0.3",
  "description": "fynpo is a zero setup monorepo manager for node.js",
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/fynpo",
  "scripts": {
    "build": "rm -rf dist && rolldown -c rolldown.config.mjs",
    "docs": "typedoc --gitRevision $(git rev-list -1 HEAD src | cut -c1-8) --out docs src",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && vitest run",
    "prepublishOnly": "xrun --serial [build, test]",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack",
    "start": "tsx src/fynpo.ts"
  },
  "keywords": [
    "lerna",
    "mono",
    "repo",
    "mono-repo",
    "workspace",
    "monorepo",
    "javascript",
    "npm",
    "build"
  ],
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "author": "Walmart GTP.js Team and Contributors",
  "contributors": [
    "Joel Chen",
    "Divya Vannilaparambath"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jchip/fynjs.git",
    "directory": "packages/fynpo"
  },
  "bin": {
    "fynpo": "bin/fynpo.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com/",
    "tag": "v3"
  },
  "publishUtil": {
    "fynIgnore": true,
    "remove": [
      {
        "dependencies": [
          "/.*/"
        ]
      }
    ],
    "keep": [
      {
        "dependencies": [
          "fyn",
          "import-fresh",
          "resolve-from",
          "resolve-global"
        ]
      }
    ]
  },
  "dependencies": {
    "@commitlint/execute-rule": "^18.6.1",
    "@commitlint/format": "^18.6.1",
    "@commitlint/lint": "^18.6.1",
    "@commitlint/read": "^18.6.1",
    "@commitlint/resolve-extends": "^18.6.1",
    "@fynjs/cli-args": "^1.0.1",
    "@fynpo/base": "^2.0.2",
    "@jchip/error": "^2.0.0",
    "aveazul": "^2.0.1",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "cosmiconfig": "^7.0.0",
    "deep-object-diff": "^1.1.7",
    "env-paths": "^4.0.0",
    "execa": "^10.0.0",
    "fs-extra": "^11.3.0",
    "fyn": "^3.0.3",
    "get-stdin": "^10.0.0",
    "import-fresh": "3.3.0",
    "item-queue": "^2.0.1",
    "lodash": "^4.17.21",
    "minimatch": "^10.0.3",
    "npm-packlist": "^11.3.0",
    "optional-require": "^2.1.1",
    "resolve-from": "^5.0.0",
    "resolve-global": "1.0.0",
    "semver": "^7.3.5",
    "shelljs": "^0.10.0",
    "slash": "^5.1.0",
    "strong-log-transformer": "^2.1.0",
    "undici": "^8.0.0",
    "visual-exec": "^1.0.2",
    "visual-logger": "^2.0.1",
    "xaa": "^3.0.0",
    "xsh": "^1.0.1"
  },
  "devDependencies": {
    "@fynjs/run": "^1.0.1",
    "@types/node": "^22.15.30",
    "@types/shelljs": "^0.8.17",
    "prettier": "^3.5.3",
    "publish-util": "^3.0.0",
    "rolldown": "^1.2.6",
    "source-map-support": "^0.5.19",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "prettier": {
    "printWidth": 100
  },
  "fyn": {
    "dependencies": {}
  }
}
