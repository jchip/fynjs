{
  "compilerOptions": {
    // TypeScript 7 turns `strict` on by default; this package has always been checked
    // without it. Pinned off so the upgrade preserves the existing bar rather than
    // silently raising it. Turning it on is worthwhile, but is its own piece of work.
    "strict": false,
    "skipLibCheck": true,
    // verbatimModuleSyntax makes tsc flag type names left in value imports. Node's
    // type-stripping is not type-aware, so such a name survives into the running JS
    // and throws "does not provide an export named ...".
    "verbatimModuleSyntax": true,
    "outDir": "lib",
    // TS7 (TS5011) requires this to be explicit; "./src" is the same common source
    // directory TS inferred before, so the emitted layout is unchanged.
    "rootDir": "./src",
    "lib": ["es2018", "dom"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "importHelpers": false,
    "target": "ES2018",
    "preserveConstEnums": true,
    "sourceMap": true,
    "declaration": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "strictFunctionTypes": true,
    "resolveJsonModule": true,
    // source is authored with explicit `.ts` relative specifiers so node can run it
    // directly with no loader; this lets tsc accept them and still emit `.js`.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
