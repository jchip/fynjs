{
  // Type-check gate that covers tests as well as src. It cannot live in
  // tsconfig.json because that one drives the build and pins
  // `rootDir: "./src"` to keep the emitted layout; test files sit outside it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src", "__tests__"]
}
