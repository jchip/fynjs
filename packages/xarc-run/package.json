{
  "name": "@fynjs/run",
  "version": "1.1.2",
  "description": "concurrent or serial run npm scripts, javascript tasks, and more",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./cli/xrun": "./dist/cli/xrun.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "pretest": "echo hello",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ci:check": "tsc --noEmit -p tsconfig.json && vitest run --coverage",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk",
    "coveralls": "cat coverage/lcov.info | coveralls",
    "coverage": "vitest run --coverage",
    "check": "fyn run coverage && fyn run coveralls",
    "format": "prettier --write --print-width 100 lib/*.js test/**/*.js",
    "xfoo2": "echo xfoo2 from npm scripts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "bin": {
    "xrun": "bin/xrun.js",
    "qrun": "bin/qrun.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jchip/fynjs.git",
    "directory": "packages/xarc-run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com/"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "concurrent",
    "parallel",
    "serial",
    "run",
    "npm",
    "script",
    "scripts",
    "xrun",
    "command",
    "line",
    "build",
    "tool",
    "shell",
    "flow",
    "control",
    "bash",
    "zsh",
    "make",
    "javascript",
    "task",
    "series",
    "tasks",
    "execution",
    "executor",
    "tool",
    "system",
    "cli",
    "stream",
    "streaming"
  ],
  "author": "Joel Chen <joel123@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/xarc-run",
  "dependencies": {
    "chalk": "^6.0.0",
    "chalker": "^2.1.1",
    "insync": "^2.1.1",
    "jaro-winkler": "^0.2.8",
    "@fynjs/cli-args": "^1.1.1",
    "optional-require": "^2.1.0",
    "read-package-up": "^12.0.0",
    "string-array": "^2.1.1",
    "unwrap-npm-cmd": "^2.1.1",
    "xsh": "^1.1.2"
  },
  "devDependencies": {
    "@fynjs/ts-resolve": "^1.0.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "munchy": "^2.0.1",
    "prettier": "^3.5.3",
    "publish-util": "^3.1.1",
    "run-verify": "^2.1.2",
    "strip-ansi": "^7.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "xaa": "^3.1.1",
    "xstdout": "^0.1.1"
  },
  "@fynjs/run": {
    "npm": true,
    "tasks": {
      "test": "echo pkg test"
    }
  },
  "prettier": {
    "printWidth": 100
  },
  "type": "module"
}
