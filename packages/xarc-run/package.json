{
  "name": "@fynjs/run",
  "version": "1.0.0",
  "description": "concurrent or serial run npm scripts, javascript tasks, and more",
  "main": "lib/index.js",
  "types": "lib/xrun.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "pretest": "echo hello",
    "test": "vitest run",
    "ci:check": "vitest run --coverage",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk",
    "coveralls": "cat coverage/lcov.info | coveralls",
    "coverage": "vitest run --coverage",
    "check": "fyn run coverage && fyn run coveralls",
    "format": "prettier --write --print-width 100 lib/*.js test/**/*.js",
    "xfoo2": "echo xfoo2 from npm scripts",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "bin": {
    "xrun": "bin/xrun.js",
    "qrun": "bin/qrun.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jchip/fynjs.git",
    "directory": "packages/xarc-run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com/"
  },
  "files": [
    "lib",
    "cli",
    "bin"
  ],
  "keywords": [
    "concurrent",
    "parallel",
    "serial",
    "run",
    "npm",
    "script",
    "scripts",
    "xrun",
    "command",
    "line",
    "build",
    "tool",
    "shell",
    "flow",
    "control",
    "bash",
    "zsh",
    "make",
    "javascript",
    "task",
    "series",
    "tasks",
    "execution",
    "executor",
    "tool",
    "system",
    "cli",
    "stream",
    "streaming"
  ],
  "author": "Joel Chen <joel123@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/xarc-run",
  "dependencies": {
    "chalk": "^6.0.0",
    "chalker": "^2.0.0",
    "insync": "^2.1.1",
    "jaro-winkler": "^0.2.8",
    "lodash.foreach": "^4.5.0",
    "@fynjs/cli-args": "^1.0.0",
    "optional-require": "^2.1.0",
    "read-pkg-up": "^7.0.1",
    "require-at": "^1.0.6",
    "string-array": "^2.0.0",
    "unwrap-npm-cmd": "^2.0.0",
    "xsh": "^1.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.0",
    "munchy": "^1.0.7",
    "prettier": "^3.5.3",
    "publish-util": "^3.0.0",
    "run-verify": "^2.0.0",
    "strip-ansi": "^6.0.0",
    "tsx": "^4.19.4",
    "vitest": "^4.1.11",
    "xaa": "^3.0.0",
    "xstdout": "^0.1.1"
  },
  "@fynjs/run": {
    "npm": true,
    "tasks": {
      "test": "echo pkg test"
    }
  },
  "prettier": {
    "printWidth": 100
  },
  "type": "module"
}
