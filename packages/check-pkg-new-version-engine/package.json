{
  "name": "check-pkg-new-version-engine",
  "version": "1.0.3",
  "description": "Provide generic engine for npm CLI packages to check newer version",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build"
  },
  "keywords": [
    "npm",
    "package",
    "new",
    "version",
    "check",
    "checker",
    "update",
    "notify",
    "notifier",
    "module",
    "cli"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/check-pkg-new-version-engine"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.2",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  },
  "dependencies": {
    "ci-info": "^2.0.0",
    "is-installed-globally": "^0.4.0",
    "mkdirp": "^1.0.4",
    "tslib": "^2.6.2"
  },
  "files": [
    "dist"
  ],
  "prettier": {
    "printWidth": 100
  },
  "sideEffects": false
}
