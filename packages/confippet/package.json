{
  "name": "@fynjs/confippet",
  "version": "1.0.0",
  "private": true,
  "description": "Managing NodeJS application configuration",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && npm test",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "config",
    "confippet"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "dependencies": {
    "js-yaml": "^5.4.1",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/confippet"
  }
}
