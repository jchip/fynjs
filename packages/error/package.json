{
  "name": "@jchip/error",
  "version": "2.0.0",
  "description": "utilities and polyfill for node.js errors",
  "homepage": "https://github.com/jchip/fynjs/tree/main/packages/error",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:check": "tsc --noEmit -p tsconfig.json && npm test",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "xrun build",
    "prepack": "publish-util-prepack",
    "postpack": "publish-util-postpack"
  },
  "keywords": [
    "errors",
    "clean",
    "error",
    "stack",
    "utilities",
    "aggregate",
    "error",
    "AggregateError",
    "polyfill",
    "cleanErrorStack"
  ],
  "author": "Joel Chen",
  "license": "Apache-2.0",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.5.3",
    "publish-util": "^3.0.0",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com/"
  },
  "bugs": {
    "url": "https://github.com/jchip/fynjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynjs.git",
    "directory": "packages/error"
  },
  "prettier": {
    "printWidth": 100
  },
  "sideEffects": false
}
